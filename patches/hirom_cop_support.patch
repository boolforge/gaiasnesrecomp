+# Optional, per-game COP-operand-width table. None by default: every
+# existing call site (7, as of this writing, none of which pass this
+# in) and every currently-shipped game is completely unaffected unless
+# something explicitly calls set_game_cop_table() first.
+#
+# Real hardware treats COP ($02) as a fixed 2-byte software interrupt,
+# and that IS what every currently-shipped snesrecomp game (all LoROM,
+# none of which use COP for anything) needs. Illusion of Gaia (HiROM)
+# repurposes it as a 209-command scripting dispatch, id byte = the
+# byte after $02, variable total length per id. Sourced from
+# Azarem/gaia-iog-baserom's us/copdef.json, cross-checked against
+# GaiaLabs' own extraction source (gaia-core src/rom/extraction/cop.ts
+# + src/types/addressing.ts) for the byte-width of each operand kind.
+# Deliberately excludes the 6/209 commands whose `halt` flag means
+# control flow does not fall through afterward — those still hit the
+# pre-existing fixed-length/poison path unchanged, rather than risk a
+# wrong guess about how to represent "this terminates" here.
+_GAME_COP_TABLE: Optional[dict] = None
+
+
+def set_game_cop_table(table: Optional[dict]) -> None:
+    """Opt in (or explicitly opt back out with None) to per-game COP
+    operand-width decoding. See _GAME_COP_TABLE above."""
+    global _GAME_COP_TABLE
+    _GAME_COP_TABLE = table
+
+
 def decode_insn(data: bytes, offset: int, pc: int, bank: int,
                 m: int = 1, x: int = 1) -> Optional[Insn]:
     """Decode one 65816 instruction. Returns None on unknown opcode."""
@@ -445,6 +472,22 @@ def decode_insn(data: bytes, offset: int, pc: int, bank: int,
         delta = v - 256 if v >= 128 else v
         return (pc + 2 + delta) & 0xFFFF
 
+    if op == 0x02 and _GAME_COP_TABLE:
+        cop_id = b(1)
+        entry = _GAME_COP_TABLE.get(cop_id)
+        if entry is not None:
+            length = 1 + entry["total_operand_bytes"]
+            # A halt-flagged command genuinely does not fall through
+            # (GaiaLabs' own cop.ts marks the position right after it
+            # as a fresh branch target). Reported as mnem='COP_HALT'
+            # -- a name that exists nowhere else in this codebase and
+            # that only this exact opt-in path can ever produce -- so
+            # decoder.py's existing _TERMINATORS check (see there)
+            # stops tracing past it, the same way it already does for
+            # RTS/RTL/BRK/etc.
+            mnem_out = "COP_HALT" if entry.get("halt") else mnem
+            return Insn((bank << 16) | pc, op, mnem_out, mode, cop_id, length)
+
     if   mode == REL:              operand = rel8()
